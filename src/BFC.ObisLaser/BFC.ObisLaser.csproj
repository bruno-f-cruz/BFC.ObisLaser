<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Bonsai - OBIS Laser</Title>
    <Description>Bonsai operators to control Coherent OBIS LX/LS lasers (unofficial, not affiliated with Coherent).</Description>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.9.0" />
    <PackageReference Include="ObisLaser.Net" Version="0.1.0" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <InternalsVisibleTo Include="BFC.ObisLaser.Tests" />
  </ItemGroup>

</Project>
