<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:obis="clr-namespace:BFC.ObisLaser;assembly=BFC.ObisLaser" xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Reads the power of lasers 1 and 2 behind an OBIS Remote or LaserBox. Commands from anywhere in the workflow go to the LaserCommands subject; the Device sends them one at a time and publishes the replies to LaserReplies. Set PortName on Device.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="obis:ObisCommand">
        <rx:Name>LaserCommands</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LaserCommands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="obis:Device">
          <obis:PortName>COM3</obis:PortName>
          <obis:Timeout>PT1S</obis:Timeout>
          <obis:MaxPendingCommands>64</obis:MaxPendingCommands>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>LaserReplies</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0S</rx:DueTime>
          <rx:Period>PT1S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="obis:CreateCommand">
        <obis:Channel>1</obis:Channel>
        <obis:Command xsi:type="obis:GetPower" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>LaserCommands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0S</rx:DueTime>
          <rx:Period>PT1S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="obis:CreateCommand">
        <obis:Channel>2</obis:Channel>
        <obis:Command xsi:type="obis:GetPower" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>LaserCommands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LaserReplies</Name>
      </Expression>
      <Expression xsi:type="obis:ParseReply">
        <obis:Command>GetPower</obis:Command>
        <obis:Channel>1</obis:Channel>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LaserReplies</Name>
      </Expression>
      <Expression xsi:type="obis:ParseReply">
        <obis:Command>GetPower</obis:Command>
        <obis:Channel>2</obis:Channel>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>